# CoreDNS for zone-c. This resolver serves ONLY zone-c's view.
#
# The registry writes /views/zone-c.zone to the shared registry-views volume.
# This container mounts that volume read-only at /etc/coredns/views.
#
# zone-c's view holds backend.zone-c as a real A record. The policy gives zone-c
# no authorized peer, so its view holds no wildcard. DNS is steering here, not a
# security control.
internal:53 {
    errors
    log
    file /etc/coredns/views/zone-c.zone internal {
        reload 5s
    }
}

.:53 {
    errors
}
